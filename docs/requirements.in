# Workshop-specific documentation dependencies.
#
# Dependencies already provided by the Sphinx Stack
# (canonical/sphinx-stack/docs/requirements.txt) must NOT be listed here.
# Only add Workshop-specific dependencies.
#
# Keep constraints loose, matching the Sphinx Stack convention. Pinning a full
# transitive closure here puts every sub-dependency into the repository
# dependency graph and generates Dependabot and Trivy findings for packages
# that Workshop neither ships nor controls.

# Ulwazi theme; replaces canonical-sphinx, which update-sphinx-stack.yaml
# drops from the Sphinx Stack requirements.
ulwazi~=1.0

# MyST linkify extension for bare URLs; formerly a canonical-sphinx dependency.
linkify-it-py~=2.0

# PDF styling for the Read the Docs PDF build; formerly part of canonical-sphinx.
sphinx-modern-pdf-style~=0.1

# Mermaid diagrams in Sphinx docs (not bundled in the Sphinx Stack).
sphinxcontrib-mermaid~=2.0

# Accessible domain and slice navigation on the home page.
sphinx-structured-toc~=0.1.1
