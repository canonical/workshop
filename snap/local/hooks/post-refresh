#!/bin/bash -e

# shellcheck source=snap/local/lib/host-config
. "$SNAP/snap/lib/host-config"
# shellcheck source=snap/local/lib/lxc-utils
. "$SNAP/snap/lib/lxc-utils"

# TODO: remove the one-off ssh/config -> ssh/ssh_config.d migration
ssh_dir="${SNAP_COMMON}/workshop/ssh"
if [ -f "${ssh_dir}/config" ]; then
    install -d -m 0755 "${ssh_dir}/ssh_config.d"
    mv -f "${ssh_dir}/config" "${ssh_dir}/ssh_config.d/workshop.conf"
fi

# TODO: remove the one-off ZFS config change (and lxc-utils if unused).
pools=$(run_lxc storage list --columns nD --format csv)
if grep -qx workshop,zfs <<<"$pools"; then
    run_lxc storage set workshop volume.zfs.use_refquota=true
fi

configure_host refresh

# TODO: remove the one-off cleanup of the obsolete experimental VM setting
snapctl unset workshop.experimental-vms

# TODO: remove a one-off data -> common migration cleanup
rm -rf "${SNAP_DATA}/ssh"
rm -rf "${SNAP_DATA}/run"
