#!/bin/sh

SDK_STORE_URL=$(snapctl get store.url)
export SDK_STORE_URL

WORKSHOP_DEBUG=$(snapctl get workshop.debug)
export WORKSHOP_DEBUG

WORKSHOP_IMAGE_SERVER=$(snapctl get workshop.image.server.url)
export WORKSHOP_IMAGE_SERVER

WORKSHOP_IMAGE_REGISTRY=$(snapctl get workshop.image.registry)
export WORKSHOP_IMAGE_REGISTRY

WORKSHOP_APT_PROXY=$(snapctl get workshop.apt.proxy)
export WORKSHOP_APT_PROXY

WORKSHOP_SNAP_STORE_URL=$(snapctl get workshop.snap.store.url)
export WORKSHOP_SNAP_STORE_URL

WORKSHOP_GO_PROXY=$(snapctl get workshop.go.proxy)
export WORKSHOP_GO_PROXY

WORKSHOP_EXPERIMENTAL_VMS=$(snapctl get workshop.experimental-vms)
export WORKSHOP_EXPERIMENTAL_VMS

read -r sbpid _ < /proc/self/stat
export LISTEN_PID="${sbpid}"

# shellcheck disable=SC2086
exec "$SNAP"/bin/workshopd run --create-dirs
